<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ALambdaNote</AssemblyName>
    <RootNamespace>ALambdaNote</RootNamespace>
    <Version>1.1.0</Version>
    <Product>ALambda Note</Product>
    <Authors>Anming_cat</Authors>
    <ApplicationTitle>ALambda Note</ApplicationTitle>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\MaterialSymbolsSharp.ttf" />
    <Resource Include="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
