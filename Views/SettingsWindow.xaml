<Window x:Class="ALambdaNote.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="pack://application:,,,/ALambdaNote;component/assets/app.ico"
        Width="560"
        Height="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

        <TextBlock Text="文件" Style="{StaticResource SectionLabel}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderBox" Grid.Column="0" />

            <Button Grid.Column="1"
                    Style="{StaticResource IconButton}"
                    Width="30"
                    Height="30"
                    Margin="6,0,0,0"
                    ToolTip="选择文件夹"
                    Click="BrowseFolder_Click">
                <TextBlock Text="&#xE2C8;" Style="{StaticResource ToolIcon}" FontSize="18" />
            </Button>
        </Grid>

        <TextBlock Text="新建文件默认保存在这里。打开已有文件后保存，仍然覆盖源文件。"
                   Margin="0,7,0,0"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap" />

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,18,0,18" />

        <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />

        <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="ThemeAutoToggle"
                          Style="{StaticResource ChoiceToggle}"
                          Margin="0,0,6,0"
                          Click="ThemeAuto_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE1AB;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock Text="跟随系统" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="ThemeLightToggle"
                          Style="{StaticResource ChoiceToggle}"
                          Margin="0,0,6,0"
                          Click="ThemeLight_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE518;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock Text="浅色" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="ThemeDarkToggle"
                          Style="{StaticResource ChoiceToggle}"
                          Click="ThemeDark_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE51C;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock Text="深色" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <TextBlock Text="主题色" Style="{StaticResource SectionLabel}" Margin="0,16,0,7" />
        <WrapPanel x:Name="AccentPanel" />

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,18,0,18" />

        <Grid>
            <TextBlock Text="编辑字号"
                       FontSize="12.5"
                       Foreground="{DynamicResource Text}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FontMinusButton"
                        Style="{StaticResource IconButton}"
                        Width="30"
                        Height="30"
                        ToolTip="减小字号"
                        Click="FontMinus_Click">
                    <TextBlock Text="&#xE15B;" Style="{StaticResource ToolIcon}" FontSize="17" />
                </Button>
                <TextBlock x:Name="FontSizeText"
                           Width="40"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Text}" />
                <Button x:Name="FontPlusButton"
                        Style="{StaticResource IconButton}"
                        Width="30"
                        Height="30"
                        ToolTip="增大字号"
                        Click="FontPlus_Click">
                    <TextBlock Text="&#xE145;" Style="{StaticResource ToolIcon}" FontSize="17" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,20,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click" />
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
