<Window x:Class="ALambdaNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="ALambda Note"
        Icon="pack://application:,,,/ALambdaNote;component/assets/app.ico"
        Width="640"
        Height="840"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource BodyFont}"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 工具栏：图钉、文件名、预览切换、设置 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="PinButton"
                              Grid.Column="0"
                              Style="{StaticResource IconToggle}"
                              ToolTip="窗口置顶"
                              Checked="PinButton_Changed"
                              Unchecked="PinButton_Changed">
                    <TextBlock Text="&#xF10D;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>

                <Button x:Name="FileNameButton"
                        Grid.Column="1"
                        Margin="10,0,16,0"
                        Style="{StaticResource FileNameButton}"
                        Click="FileNameButton_Click">
                    <TextBlock x:Name="FileNameText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"
                               Text="未命名"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"
                               Cursor="Hand"
                               MouseRightButtonUp="FileNameText_MouseRightButtonUp" />
                </Button>

                <TextBox x:Name="FileNameBox"
                         Grid.Column="1"
                         Margin="10,0,16,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         MinWidth="120"
                         MaxWidth="360"
                         MaxLength="180"
                         Visibility="Collapsed"
                         FocusVisualStyle="{x:Null}"
                         ToolTip="输入新的文件名，回车确认，Esc 取消"
                         KeyDown="FileNameBox_KeyDown"
                         LostKeyboardFocus="FileNameBox_LostKeyboardFocus" />

                <ToggleButton x:Name="PreviewToggle"
                              Grid.Column="3"
                              Style="{StaticResource IconToggle}"
                              ToolTip="预览 (Ctrl+P)"
                              Click="PreviewToggle_Click">
                    <TextBlock x:Name="PreviewIcon" Text="&#xF1C5;" Style="{StaticResource ToolIcon}" />
                </ToggleButton>

                <Button x:Name="SettingsButton"
                        Grid.Column="4"
                        Style="{StaticResource IconButton}"
                        ToolTip="设置"
                        Click="SettingsButton_Click">
                    <TextBlock Text="&#xE8B8;" Style="{StaticResource ToolIcon}" />
                </Button>
            </Grid>
        </Border>

        <!-- 编辑区 / 预览区 -->
        <Grid Grid.Row="1">
            <Border x:Name="EditorHost"
                    Background="{DynamicResource Bg}"
                    Padding="30,18,8,10">
                <avalon:TextEditor x:Name="Editor"
                                   Background="Transparent"
                                   Foreground="{DynamicResource Text}"
                                   FontFamily="Dubai, Segoe UI"
                                   FontSize="17"
                                   ShowLineNumbers="False"
                                   WordWrap="True"
                                   BorderThickness="0"
                                   Padding="2,0,0,0"
                                   AllowDrop="False"
                                   HorizontalScrollBarVisibility="Disabled"
                                   VerticalScrollBarVisibility="Auto" />
            </Border>

            <Border x:Name="PreviewHost"
                    Background="{DynamicResource Bg}"
                    Padding="44,22,44,30"
                    Visibility="Collapsed">
                <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          IsToolBarVisible="False"
                                          IsSelectionEnabled="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <Border x:Name="DropOverlay"
                    Background="{DynamicResource Overlay}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xEAF3;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="44"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="松开以打开文件"
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource Text}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="支持 Markdown 与纯文本"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏：保存指示灯、文件路径、编码 -->
        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="DirtyLight"
                             Width="7"
                             Height="7"
                             Fill="{DynamicResource TextMuted}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="PathText"
                               Margin="8,0,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="尚未保存" />
                </StackPanel>

                <Button x:Name="EncodingButton"
                        Grid.Column="1"
                        Style="{StaticResource StatusButton}"
                        VerticalAlignment="Center"
                        ToolTip="保存时使用的编码"
                        Click="EncodingButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EncodingText" Text="ANSI" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE5CF;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
